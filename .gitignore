# Byte-compiled Python files
__pycache__/
*.py[cod]
*$py.class

# Virtual environments (very important to ignore these — they're huge and machine-specific)
.venv/
venv/
env/
ENV/

# Jupyter notebook checkpoints (auto-save folders Jupyter creates)
.ipynb_checkpoints/

# Qiskit / quantum computing specific
.qiskit/
qiskit_ibm_provider_cache/
*.qasm~

# Distribution / build artifacts
build/
dist/
*.egg-info/

# Testing / coverage
.pytest_cache/
.coverage
htmlcov/

# Type checker / linter caches
.mypy_cache/
.ruff_cache/

# IDE / editor settings
.vscode/
.idea/

# OS junk files
.DS_Store
Thumbs.db

# Environment variables / secrets (if you ever use API keys, e.g. IBM Quantum tokens)
.env
